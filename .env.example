# Environment variables read by the tests. Export them in your shell or set them as CI secrets;
# this file only documents them and must never contain real credentials.

# Profile from config/environments.json: demo-webshop (default), ci, debug. Same as --env.
SHOP_ENV=demo-webshop

# Optional existing account. Leave both empty to register a fresh user per test (default).
# Set both or neither; the password is never logged.
SHOP_EMAIL=
SHOP_PASSWORD=

# Optional other shopping-cases file (default data/shopping_cases.json). Same as --cases.
SHOP_CASES=
